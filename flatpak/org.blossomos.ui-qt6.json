{
  "id": "org.blossomos.ui",
  "branch": "6.9",
  "runtime": "org.kde.Platform",
  "build-extension": true,
  "sdk": "org.kde.Sdk",
  "runtime-version": "6.9",
  "appstream-compose": false,
  "separate-locales": false,
  "modules": [
    {
      "name": "BlossomUI",
      "buildsystem": "cmake",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_INSTALL_PREFIX=/app",
        "-DKDE_INSTALL_PLUGINDIR=/app/lib/plugins",
        "-DKDE_INSTALL_KCONFMODULEDIR=/app/lib/plugins",
        "-DKDE_INSTALL_KCMMODULEDIR=/app/lib/qt6/plugins",
        "-DKDE_INSTALL_DATADIR=/app/share",
        "-DBUILD_QT6=ON",
        "-DBUILD_QT5=OFF",
        "-DWITH_DECORATIONS=ON",
        "-DFOR_FLATPAK=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "blossomui-flatpak-source.tar.gz"
        }
      ]
    }
  ]
}
