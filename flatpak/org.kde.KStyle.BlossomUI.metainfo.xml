<?xml version="1.0" encoding="UTF-8" ?>
<component type="addon">
  <id>org.kde.KStyle.BlossomUI</id>
  <extends>org.kde.Platform</extends>
  <name>BlossomUI</name>
  <summary>Modern global theme for Qt/KDE applications</summary>
  <description>
    <p>
      BlossomUI is a modern global theme for Qt and KDE applications, forked from Darkly.
      This extension provides the BlossomUI style for Qt6 applications running in Flatpak.
    </p>
    <p>Includes:</p>
    <ul>
      <li>Application Style (KStyle) for Qt6</li>
      <li>Window Decoration for KWin</li>
      <li>Global Look-and-Feel themes</li>
      <li>Plasma Desktop Theme</li>
      <li>Icon Theme</li>
      <li>Wallpapers</li>
      <li>Color Schemes</li>
    </ul>
  </description>
  <url type="homepage">https://git.blossomos.org/Blossom/ui</url>
  <url type="bugtracker">https://git.blossomos.org/Blossom/ui/issues</url>
  <url type="vcs-browser">https://git.blossomos.org/Blossom/ui</url>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <developer_name>BlossomOS Team</developer_name>
  <releases>
    <release version="0.1.0" date="2025-01-01">
      <description>
        <p>Initial release of BlossomUI for Flatpak</p>
      </description>
    </release>
  </releases>
</component>
