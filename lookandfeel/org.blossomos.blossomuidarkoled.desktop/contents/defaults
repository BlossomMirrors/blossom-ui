[kdeglobals][KDE]
widgetStyle=BlossomUI

[kdeglobals][General]
ColorScheme=BlossomUI Dark OLED

[kdeglobals][Icons]
Theme=breeze-dark

[plasmarc][Theme]
name=default

[Wallpaper]
Image=Next

[kcminputrc][Mouse]
cursorTheme=Bibata-Modern-Classic
cursorThemeFallback=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.blossomui
theme=BlossomUI

[ksplashrc][KSplash]
Theme=None
Engine=KSplashQML

[kwinrc][Plugins]
blurEnabled=true

[kwinrc][Effect-Blur]
BlurStrength=5

[plasmarc][ContrastEffect]
enabled=true
contrast=0.25
intensity=1.4
saturation=1.3

[Sounds]
Theme=modern-minimal-ui-sounds
ThemeFallback=ocean
