@PACKAGE_INIT@

set(BLOSSOMUI_WITH_KDECORATION @WITH_DECORATIONS@)
if(${BLOSSOMUI_WITH_KDECORATION})
    set(BLOSSOMUI_KDECORATION_PLUGIN_ID "org.kde.blossomui")
else()
    set(BLOSSOMUI_KDECORATION_PLUGIN_ID "")
endif()

set(BLOSSOMUI_STYLE_NAME "blossomui")
