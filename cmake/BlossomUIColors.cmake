if(EXISTS "${CMAKE_SOURCE_DIR}/../colors.json")
    file(READ "${CMAKE_SOURCE_DIR}/../colors.json" _bui_json)
elseif(EXISTS "${CMAKE_SOURCE_DIR}/colors.json")
    file(READ "${CMAKE_SOURCE_DIR}/colors.json" _bui_json)
else()
    message(FATAL_ERROR "colors.json not found at ${CMAKE_SOURCE_DIR}/../ or ${CMAKE_SOURCE_DIR}/")
endif()

foreach(_bui_group IN ITEMS neutral primary secondary tertiary quaternary red)
    string(JSON _bui_n LENGTH "${_bui_json}" "${_bui_group}")
    string(TOUPPER "${_bui_group}" _bui_GROUP)
    math(EXPR _bui_last "${_bui_n} - 1")
    foreach(_bui_i RANGE ${_bui_last})
        string(JSON _bui_step MEMBER "${_bui_json}" "${_bui_group}" ${_bui_i})
        string(JSON _bui_hex  GET    "${_bui_json}" "${_bui_group}" "${_bui_step}")
        string(REPLACE "#" "" _bui_hx "${_bui_hex}")
        string(SUBSTRING "${_bui_hx}" 0 2 _bui_hr)
        string(SUBSTRING "${_bui_hx}" 2 2 _bui_hg)
        string(SUBSTRING "${_bui_hx}" 4 2 _bui_hb)
        math(EXPR _bui_r "0x${_bui_hr}")
        math(EXPR _bui_g "0x${_bui_hg}")
        math(EXPR _bui_b "0x${_bui_hb}")
        set(${_bui_GROUP}_${_bui_step}_RGB "${_bui_r},${_bui_g},${_bui_b}")
        string(TOLOWER "${_bui_hx}" _bui_hx_lower)
        set(${_bui_GROUP}_${_bui_step}_HEX "#${_bui_hx_lower}")
    endforeach()
endforeach()

string(JSON _bui_mod GET "${_bui_json}" surface-mod color)
string(TOLOWER "${_bui_mod}" SURFACE_MOD_HEX)
foreach(_bui_mode IN ITEMS light dark)
    foreach(_bui_tier IN ITEMS subtle normal strong)
        string(TOUPPER "SURFACE_MOD_${_bui_mode}_${_bui_tier}" _bui_name)
        string(JSON ${_bui_name} GET "${_bui_json}" surface-mod ${_bui_mode} ${_bui_tier})
    endforeach()
endforeach()

# kde and konsole only take solid colors so a surface mod is laid over a neutral step here
function(_bui_surface_mod step mode tier)
    string(JSON _mod GET "${_bui_json}" surface-mod color)
    string(JSON _alpha GET "${_bui_json}" surface-mod ${mode} ${tier})
    string(REPLACE "," ";" _base "${NEUTRAL_${step}_RGB}")
    set(_rgb "")
    set(_hex "#")
    foreach(_i IN ITEMS 0 1 2)
        list(GET _base ${_i} _b)
        math(EXPR _at "1 + ${_i} * 2")
        string(SUBSTRING "${_mod}" ${_at} 2 _m)
        math(EXPR _v "(${_b} * (100 - ${_alpha}) + 0x${_m} * ${_alpha} + 50) / 100")
        list(APPEND _rgb ${_v})
        math(EXPR _h "256 + ${_v}" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${_h}" 3 2 _h)
        string(APPEND _hex "${_h}")
    endforeach()
    string(TOUPPER "NEUTRAL_${step}_${mode}_${tier}" _name)
    string(REPLACE ";" "," ${_name}_RGB "${_rgb}")
    set(${_name}_RGB "${${_name}_RGB}" PARENT_SCOPE)
    string(TOLOWER "${_hex}" ${_name}_HEX)
    set(${_name}_HEX "${${_name}_HEX}" PARENT_SCOPE)
endfunction()

_bui_surface_mod(25 light subtle)
_bui_surface_mod(900 dark subtle)
