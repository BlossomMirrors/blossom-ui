if(EXISTS "${CMAKE_SOURCE_DIR}/../colors.json")
    file(READ "${CMAKE_SOURCE_DIR}/../colors.json" _bui_json)
elseif(EXISTS "${CMAKE_SOURCE_DIR}/colors.json")
    file(READ "${CMAKE_SOURCE_DIR}/colors.json" _bui_json)
else()
    message(FATAL_ERROR "colors.json not found at ${CMAKE_SOURCE_DIR}/../ or ${CMAKE_SOURCE_DIR}/")
endif()

# templates use a color as @NAME_RGB@ in kde files and as @NAME_HEX@ everywhere else
macro(_bui_color name hex)
    string(REPLACE "#" "" _bui_hx "${hex}")
    string(SUBSTRING "${_bui_hx}" 0 2 _bui_hr)
    string(SUBSTRING "${_bui_hx}" 2 2 _bui_hg)
    string(SUBSTRING "${_bui_hx}" 4 2 _bui_hb)
    math(EXPR _bui_r "0x${_bui_hr}")
    math(EXPR _bui_g "0x${_bui_hg}")
    math(EXPR _bui_b "0x${_bui_hb}")
    set(${name}_RGB "${_bui_r},${_bui_g},${_bui_b}")
    string(TOLOWER "#${_bui_hx}" ${name}_HEX)
endmacro()

foreach(_bui_group IN ITEMS neutral primary secondary tertiary quaternary red)
    string(JSON _bui_n LENGTH "${_bui_json}" "${_bui_group}")
    string(TOUPPER "${_bui_group}" _bui_GROUP)
    math(EXPR _bui_last "${_bui_n} - 1")
    foreach(_bui_i RANGE ${_bui_last})
        string(JSON _bui_step MEMBER "${_bui_json}" "${_bui_group}" ${_bui_i})
        string(JSON _bui_hex  GET    "${_bui_json}" "${_bui_group}" "${_bui_step}")
        _bui_color(${_bui_GROUP}_${_bui_step} "${_bui_hex}")
    endforeach()
endforeach()

# surfaces text and surface mods only point at a primitive like neutral.900 so no color exists outside the palette
macro(_bui_primitive out ref)
    string(REPLACE "." ";" _bui_ref "${ref}")
    list(GET _bui_ref 0 _bui_ref_group)
    list(GET _bui_ref 1 _bui_ref_step)
    string(JSON ${out} GET "${_bui_json}" "${_bui_ref_group}" "${_bui_ref_step}")
endmacro()

# lays a color over a solid one at a percentage for kde and gtk files that only take solid colors
macro(_bui_blend name top base percent)
    set(_bui_hex "#")
    foreach(_bui_at IN ITEMS 1 3 5)
        string(SUBSTRING "${top}" ${_bui_at} 2 _bui_t)
        string(SUBSTRING "${base}" ${_bui_at} 2 _bui_b)
        math(EXPR _bui_v "(0x${_bui_b} * (100 - ${percent}) + 0x${_bui_t} * ${percent} + 50) / 100 + 256" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${_bui_v}" 3 2 _bui_v)
        string(APPEND _bui_hex "${_bui_v}")
    endforeach()
    _bui_color(${name} "${_bui_hex}")
endmacro()

foreach(_bui_mode IN ITEMS light dark)
    foreach(_bui_level IN ITEMS low base high highest)
        string(JSON _bui_ref GET "${_bui_json}" surface ${_bui_mode} ${_bui_level})
        _bui_primitive(_bui_hex "${_bui_ref}")
        string(TOUPPER "SURFACE_${_bui_mode}_${_bui_level}" _bui_name)
        _bui_color(${_bui_name} "${_bui_hex}")
    endforeach()
endforeach()

# each theme has its own surface mod color and strengths
# zed and the window decoration keep the transparency and kde and gtk get it laid over surface base
foreach(_bui_mode IN ITEMS light dark)
    string(JSON _bui_ref GET "${_bui_json}" surface-mod ${_bui_mode} color)
    _bui_primitive(_bui_mod "${_bui_ref}")
    string(SUBSTRING "${_bui_mod}" 1 6 _bui_rgb)
    foreach(_bui_tier IN ITEMS subtle normal strong)
        string(JSON _bui_percent GET "${_bui_json}" surface-mod ${_bui_mode} ${_bui_tier})
        math(EXPR _bui_alpha "(${_bui_percent} * 255 + 50) / 100 + 256" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${_bui_alpha}" 3 2 _bui_alpha)
        string(TOUPPER "SURFACE_MOD_${_bui_mode}_${_bui_tier}" _bui_name)
        string(TOLOWER "#${_bui_rgb}${_bui_alpha}" ${_bui_name}_ALPHA_HEX)
        # qt reads eight digit colors with the alpha first so the window decoration gets that order
        string(TOLOWER "#${_bui_alpha}${_bui_rgb}" ${_bui_name}_ARGB)
        string(TOUPPER "SURFACE_${_bui_mode}_BASE_HEX" _bui_base)
        _bui_blend(${_bui_name} "${_bui_mod}" "${${_bui_base}}" ${_bui_percent})
    endforeach()
    # titlebar minimize and maximize buttons use the same surface mod color at their own strengths
    foreach(_bui_state IN ITEMS hover hover-border pressed)
        string(JSON _bui_percent GET "${_bui_json}" window-button ${_bui_state})
        math(EXPR _bui_alpha "(${_bui_percent} * 255 + 50) / 100 + 256" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${_bui_alpha}" 3 2 _bui_alpha)
        string(REPLACE "-" "_" _bui_state_name "${_bui_state}")
        string(TOUPPER "WINDOW_BUTTON_${_bui_mode}_${_bui_state_name}" _bui_name)
        string(TOLOWER "#${_bui_alpha}${_bui_rgb}" ${_bui_name}_ARGB)
        # gtk reads transparency only as rgba so the gtk theme gets that form
        _bui_color(_bui_mod_color "${_bui_mod}")
        math(EXPR _bui_whole "${_bui_percent} / 100")
        math(EXPR _bui_frac "${_bui_percent} % 100")
        if(_bui_frac LESS 10)
            set(_bui_frac "0${_bui_frac}")
        endif()
        set(${_bui_name}_RGBA "rgba(${_bui_mod_color_RGB}, ${_bui_whole}.${_bui_frac})")
    endforeach()
endforeach()

foreach(_bui_mode IN ITEMS light dark)
    foreach(_bui_role IN ITEMS heading primary tertiary)
        string(JSON _bui_ref GET "${_bui_json}" text ${_bui_mode} ${_bui_role})
        _bui_primitive(_bui_hex "${_bui_ref}")
        string(TOUPPER "TEXT_${_bui_mode}_${_bui_role}" _bui_name)
        _bui_color(${_bui_name} "${_bui_hex}")
    endforeach()
endforeach()
