{
  "id": "org.kde.KStyle.BlossomUI",
  "branch": "6.9",
  "runtime": "org.kde.Platform",
  "build-extension": true,
  "sdk": "org.kde.Sdk",
  "runtime-version": "6.9",
  "appstream-compose": false,
  "separate-locales": false,
  "modules": [
    {
      "name": "BlossomUI",
      "buildsystem": "cmake",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_INSTALL_PREFIX=/usr",
        "-DBUILD_QT6=ON",
        "-DBUILD_QT5=OFF",
        "-DWITH_DECORATIONS=ON",
        "-DFOR_FLATPAK=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://git.blossomos.org/Blossom/ui",
          "branch": "main"
        }
      ]
    }
  ]
}
